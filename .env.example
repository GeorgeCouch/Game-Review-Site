# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=generate-a-long-random-string
APP_BASE_URL=http://localhost:3000

# Postgres — either DATABASE_URL *or* discrete vars
DATABASE_URL=postgresql://user:pass@host:5432/gamecouch

# IGDB / Twitch
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/profile

# ---------- SMTP ----------
# Required for real verification / password-reset emails.
# If these are blank, GameCouch prints the email body in the server console instead.

# === Option A: Gmail (recommended for local testing) ===
# 1. Visit https://myaccount.google.com/security
# 2. Turn on 2-Step Verification
# 3. Open https://myaccount.google.com/apppasswords
# 4. Create an app password for "Mail" (16 characters, no spaces)
# 5. Fill these in:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="GameCouch <you@gmail.com>"

# === Option B: Ethereal (fake inbox, no real delivery) ===
# 1. Open https://ethereal.email and create an account
# 2. Copy the SMTP host/user/pass they show you
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM="GameCouch <...@ethereal.email>"

# === Option C: SendGrid ===
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxx
# SMTP_FROM="GameCouch <you@yourdomain.com>"

# Optional: set to false only if you hit TLS certificate errors on local SMTP
# SMTP_TLS_REJECT_UNAUTHORIZED=true
