<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diary – <%= profile.display_name || profile.username %> – GameCouch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>
            <% if (typeof userlog !== "undefined" && userlog && userlog.id === profile.id) { %>
              Your Diary
            <% } else { %>
              <%= profile.display_name || profile.username %>'s Diary
            <% } %>
          </h1>
          <p>
            <%= entries.length %> entr<%= entries.length === 1 ? "y" : "ies" %>
            · games logged by completion date
          </p>
        </div>
      </div>

      <% if (!entries || entries.length === 0) { %>
        <div class="empty-state">
          <h2>No diary entries yet</h2>
          <p>
            Entries appear when a review has a <strong>Completed Date</strong>.
            <% if (typeof userlog !== "undefined" && userlog && userlog.id === profile.id) { %>
              Add or edit a review to log one.
            <% } %>
          </p>
          <% if (typeof userlog !== "undefined" && userlog && userlog.id === profile.id) { %>
            <a href="/add" class="nav-btn nav-btn-primary">+ Add Review</a>
          <% } %>
        </div>
      <% } else { %>
        <% 
          let lastMonthKey = null;
          entries.forEach(function(entry) {
            const d = entry.completed ? new Date(entry.completed) : null;
            const monthKey = d
              ? d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
              : 'Unknown';
            const dayNum = d ? d.getDate() : '—';
            const rating = parseFloat(entry.rating) || 0;
            const fullStars = Math.floor(rating);
        %>
          <% if (monthKey !== lastMonthKey) { %>
            <% if (lastMonthKey !== null) { %>
              </div>
            <% } %>
            <h2 class="diary-month"><%= monthKey %></h2>
            <div class="diary-month-list">
            <% lastMonthKey = monthKey; %>
          <% } %>

          <div class="diary-entry">
            <div class="diary-day"><%= dayNum %></div>
            <a href="/game/<%= entry.game_id %>" class="diary-cover-link">
              <% if (entry.cover_url) { %>
                <img src="<%= entry.cover_url %>" alt="" class="diary-cover" />
              <% } else { %>
                <div class="diary-cover diary-cover-placeholder">?</div>
              <% } %>
            </a>
            <div class="diary-body">
              <a href="/game/<%= entry.game_id %>" class="diary-game-title"><%= entry.title %></a>
              <div class="diary-stars">
                <% for (let s = 1; s <= 5; s++) { %>
                  <span class="star<%= s <= fullStars ? '' : ' empty' %>">★</span>
                <% } %>
                <span class="diary-rating-num"><%= rating.toFixed(1) %></span>
              </div>
              <% if (entry.notes) { %>
                <p class="diary-notes"><%= entry.notes.length > 160 ? entry.notes.slice(0, 160) + "…" : entry.notes %></p>
              <% } %>
            </div>
          </div>
        <% }); %>
        <% if (lastMonthKey !== null) { %>
          </div>
        <% } %>
      <% } %>
    </div>
      <script src="/js/nav.js"></script>
  </body>
</html>
