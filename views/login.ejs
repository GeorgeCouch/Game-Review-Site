<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Game Blog</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-custom fixed-top">
      <div class="container-fluid px-4">
        <a class="navbar-brand" href="/">Video Game <span>Blog</span></a>
        <a href="/" class="nav-btn">← Back</a>
      </div>
    </nav>

    <div class="page-wrapper">
      <div class="form-card">
        <h1>Login</h1>
        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input
              class="form-control"
              type="email"
              name="username"
              placeholder="you@example.com"
              required
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              class="form-control"
              type="password"
              name="password"
              required
            />
          </div>
          <button type="submit" class="btn-submit">Login</button>
        </form>

        <p style="text-align: center; margin-top: 1.25rem; color: var(--text-muted); font-size: 0.9rem;">
          Don't have an account?
          <a href="/register" style="color: var(--accent);">Register</a>
        </p>
      </div>
    </div>
  </body>
</html>