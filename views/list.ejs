<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= list.title %> – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="list-header">
        <div>
          <p class="list-owner">
            List by
            <a href="/u/<%= owner.username %>" style="color: var(--accent);">
              <%= owner.display_name || owner.username %>
            </a>
          </p>
          <h1 class="list-title"><%= list.title %></h1>
          <% if (list.description) { %>
            <p class="list-description"><%= list.description %></p>
          <% } %>
          <p class="list-meta">
            <%= items.length %> game<%= items.length === 1 ? "" : "s" %>
            <% if (list.is_ranked) { %> · Numbered <% } %>
          </p>
        </div>

        <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
          <div class="list-owner-actions">
            <form action="/lists/<%= list.id %>/toggle-numbered" method="POST">
              <button type="submit" class="nav-btn">
                <%= list.is_ranked ? "Hide numbers" : "Make numbered" %>
              </button>
            </form>
            <form action="/lists/<%= list.id %>/delete" method="POST" onsubmit="return confirm('Delete this entire list?');">
              <button type="submit" class="nav-btn" style="color: var(--danger); border-color: var(--danger);">Delete list</button>
            </form>
          </div>
        <% } %>
      </div>

      <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
        <div class="form-card" style="max-width: 100%; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1rem; margin: 0 0 0.75rem;">Add a game</h3>
          <input
            class="form-control"
            type="text"
            id="list-game-search"
            placeholder="Search for a game to add…"
            autocomplete="off"
          />
          <div id="list-search-status" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;"></div>
          <div id="list-search-results" class="search-results"></div>
        </div>
      <% } %>

      <% if (!items || items.length === 0) { %>
        <div class="empty-state">
          <h2>This list is empty</h2>
          <p>
            <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
              Search above to add your first game.
            <% } else { %>
              No games have been added yet.
            <% } %>
          </p>
        </div>
      <% } else { %>
        <div class="list-items<%= (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) ? " list-items-sortable" : "" %>" id="list-items" data-list-id="<%= list.id %>">
          <% items.forEach(function(item, idx) { %>
            <div class="list-item<%= (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) ? " is-draggable" : "" %>" data-item-id="<%= item.id %>" <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>draggable="true"<% } %>>
              <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
                <button type="button" class="list-drag-handle" title="Drag to reorder" aria-label="Drag to reorder">⠿</button>
              <% } %>
              <% if (list.is_ranked) { %>
                <div class="list-rank"><%= idx + 1 %></div>
              <% } %>
              <a href="/game/<%= item.game_id %>" class="list-item-main">
                <% if (item.cover_url) { %>
                  <img src="<%= item.cover_url %>" alt="" class="list-item-cover" draggable="false" />
                <% } else { %>
                  <div class="list-item-cover list-item-cover-placeholder">?</div>
                <% } %>
                <div>
                  <div class="list-item-title"><%= item.title %></div>
                  <% if (item.notes) { %>
                    <div class="list-item-notes"><%= item.notes %></div>
                  <% } %>
                </div>
              </a>
              <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
                <div class="list-item-actions">
                  <form action="/lists/<%= list.id %>/items/<%= item.id %>/delete" method="POST" style="display:inline;">
                    <button type="submit" class="nav-btn" style="padding: 0.3rem 0.65rem; font-size: 0.8rem;">Remove</button>
                  </form>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (typeof userlog !== "undefined" && userlog && userlog.id === list.user_id) { %>
    <script>
      const searchInput = document.getElementById("list-game-search");
      const resultsEl = document.getElementById("list-search-results");
      const statusEl = document.getElementById("list-search-status");
      let debounceTimer = null;

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        const q = searchInput.value.trim();
        if (q.length < 2) {
          resultsEl.innerHTML = "";
          statusEl.textContent = "";
          return;
        }
        statusEl.textContent = "Searching…";
        debounceTimer = setTimeout(async () => {
          try {
            const res = await fetch("/api/games/search?q=" + encodeURIComponent(q));
            const data = await res.json();
            if (!res.ok) {
              statusEl.textContent = data.error || "Search failed";
              resultsEl.innerHTML = "";
              return;
            }
            const results = data.results || [];
            statusEl.textContent = results.length
              ? results.length + " result" + (results.length === 1 ? "" : "s")
              : "No games found";
            resultsEl.innerHTML = results
              .map(
                (g) => `
              <form action="/lists/<%= list.id %>/items" method="POST" class="search-result-item" style="margin:0;">
                <input type="hidden" name="game_id" value="${g.id}" />
                <input type="hidden" name="title" value="${escapeHtml(g.name)}" />
                <input type="hidden" name="cover_url" value="${g.cover || ""}" />
                ${g.cover ? `<img src="${g.cover}" alt="" />` : `<div class="search-result-placeholder"></div>`}
                <div style="flex:1;">
                  <div class="search-result-name">${escapeHtml(g.name)}</div>
                  <div class="search-result-meta">${g.released ? new Date(g.released).getFullYear() : "—"}</div>
                </div>
                <button type="submit" class="nav-btn nav-btn-primary" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">Add</button>
              </form>`
              )
              .join("");
          } catch (err) {
            statusEl.textContent = "Search error";
            resultsEl.innerHTML = "";
          }
        }, 300);
      });
    </script>
    <% } %>
      
    <script>
      (function () {
        const listEl = document.getElementById("list-items");
        if (!listEl || !listEl.classList.contains("list-items-sortable")) return;

        const listId = listEl.dataset.listId;
        let dragEl = null;
        let touchGhost = null;
        let touchOffsetY = 0;
        let lastTouchY = 0;

        function items() {
          return [...listEl.querySelectorAll(".list-item")];
        }

        function updateRanks() {
          items().forEach((el, idx) => {
            const rank = el.querySelector(".list-rank");
            if (rank) rank.textContent = String(idx + 1);
          });
        }

        async function saveOrder() {
          const order = items().map((el) => el.dataset.itemId);
          try {
            const res = await fetch("/lists/" + listId + "/reorder", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify({ order }),
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              console.error("Reorder failed", data.error || res.status);
            }
          } catch (err) {
            console.error("Reorder error", err);
          }
        }

        function moveDragElFromY(clientY) {
          if (!dragEl) return;
          const others = items().filter((el) => el !== dragEl);
          let placed = false;
          for (const item of others) {
            const rect = item.getBoundingClientRect();
            const mid = rect.top + rect.height / 2;
            if (clientY < mid) {
              listEl.insertBefore(dragEl, item);
              placed = true;
              break;
            }
          }
          if (!placed) listEl.appendChild(dragEl);
        }

        // Desktop HTML5 DnD
        items().forEach((item) => {
          item.addEventListener("dragstart", (e) => {
            // Ignore if starting from a button/link that shouldn't drag the row via native only on handle preferred
            dragEl = item;
            item.classList.add("is-dragging");
            e.dataTransfer.effectAllowed = "move";
            try {
              e.dataTransfer.setData("text/plain", item.dataset.itemId);
            } catch (_) {}
          });
          item.addEventListener("dragend", () => {
            item.classList.remove("is-dragging");
            dragEl = null;
            updateRanks();
            saveOrder();
          });
          item.addEventListener("dragover", (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
            if (!dragEl || dragEl === item) return;
            const rect = item.getBoundingClientRect();
            const before = e.clientY < rect.top + rect.height / 2;
            listEl.insertBefore(dragEl, before ? item : item.nextSibling);
          });
          item.addEventListener("drop", (e) => e.preventDefault());
        });

        // Touch support (handle-based to avoid scrolling conflicts)
        function onTouchStart(e) {
          const handle = e.target.closest(".list-drag-handle");
          if (!handle) return;
          const item = handle.closest(".list-item");
          if (!item || !listEl.contains(item)) return;

          const touch = e.touches[0];
          dragEl = item;
          lastTouchY = touch.clientY;
          const rect = item.getBoundingClientRect();
          touchOffsetY = touch.clientY - rect.top;

          item.classList.add("is-dragging", "is-touch-dragging");

          touchGhost = item.cloneNode(true);
          touchGhost.classList.add("list-touch-ghost");
          touchGhost.style.width = rect.width + "px";
          touchGhost.style.left = rect.left + "px";
          touchGhost.style.top = rect.top + "px";
          document.body.appendChild(touchGhost);

          // Prevent page scroll while dragging
          e.preventDefault();
        }

        function onTouchMove(e) {
          if (!dragEl || !touchGhost) return;
          const touch = e.touches[0];
          lastTouchY = touch.clientY;
          touchGhost.style.top = touch.clientY - touchOffsetY + "px";
          moveDragElFromY(touch.clientY);
          e.preventDefault();
        }

        function onTouchEnd() {
          if (!dragEl) return;
          dragEl.classList.remove("is-dragging", "is-touch-dragging");
          if (touchGhost) {
            touchGhost.remove();
            touchGhost = null;
          }
          dragEl = null;
          updateRanks();
          saveOrder();
        }

        listEl.addEventListener("touchstart", onTouchStart, { passive: false });
        listEl.addEventListener("touchmove", onTouchMove, { passive: false });
        listEl.addEventListener("touchend", onTouchEnd);
        listEl.addEventListener("touchcancel", onTouchEnd);
      })();
    </script>

      <script src="/js/nav.js"></script>
  </body>
</html>
