<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>Moderation</h1>
          <p>Admin tools for GameCouch</p>
        </div>
      </div>

      <div class="profile-stats-panel" style="margin-top: 0;">
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= stats.users %></div>
          <div class="profile-stat-label">Users</div>
        </div>
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= stats.reviews %></div>
          <div class="profile-stat-label">Reviews</div>
        </div>
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= stats.comments %></div>
          <div class="profile-stat-label">Comments</div>
        </div>
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= stats.openReports %></div>
          <div class="profile-stat-label">Open reports</div>
        </div>
      </div>

      <!-- Reports -->
      <div class="page-header" style="margin-top: 2rem;">
        <div>
          <h2 style="font-size: 1.2rem; margin: 0; font-weight: 700;">Open reports</h2>
        </div>
      </div>
      <% if (!reports || !reports.length) { %>
        <p style="color: var(--text-muted);">No open reports.</p>
      <% } else { %>
        <div class="admin-table">
          <% reports.forEach(function(r) { %>
            <div class="admin-row">
              <div class="admin-row-main">
                <div class="admin-row-title">
                  <%= r.target_type %> #<%= r.target_id %>
                  <span class="admin-muted">
                    by <%= r.reporter_display_name || r.reporter_username || "unknown" %>
                  </span>
                </div>
                <div class="admin-muted"><%= r.reason || "No reason given" %></div>
                <div class="admin-muted" style="font-size: 0.75rem;">
                  <%= r.created_at ? new Date(r.created_at).toLocaleString() : "" %>
                  <% if (r.target_type === "review") { %>
                    · <a href="/review/<%= r.target_id %>" style="color: var(--accent);">View review</a>
                  <% } else if (r.target_type === "user") { %>
                    · <a href="/u/<%= r.target_id %>" style="color: var(--accent);">User id <%= r.target_id %></a>
                  <% } %>
                </div>
              </div>
              <div class="admin-row-actions">
                <form action="/admin/reports/<%= r.id %>/resolve" method="POST">
                  <input type="hidden" name="status" value="resolved" />
                  <button class="nav-btn nav-btn-primary" type="submit">Resolve</button>
                </form>
                <form action="/admin/reports/<%= r.id %>/resolve" method="POST">
                  <input type="hidden" name="status" value="dismissed" />
                  <button class="nav-btn" type="submit">Dismiss</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- Recent reviews -->
      <div class="page-header" style="margin-top: 2rem;">
        <div>
          <h2 style="font-size: 1.2rem; margin: 0; font-weight: 700;">Recent reviews</h2>
        </div>
      </div>
      <div class="admin-table">
        <% (recentReviews || []).forEach(function(g) { %>
          <div class="admin-row">
            <div class="admin-row-main">
              <div class="admin-row-title">
                <a href="/review/<%= g.id %>" style="color: inherit;"><%= g.title %></a>
                <span class="admin-muted">· <%= g.rating %>/5</span>
              </div>
              <div class="admin-muted">
                by
                <% if (g.username) { %>
                  <a href="/u/<%= g.username %>" style="color: var(--accent);"><%= g.display_name || g.username %></a>
                <% } else { %>
                  user #<%= g.user_id %>
                <% } %>
              </div>
              <% if (g.notes) { %>
                <div class="admin-muted" style="margin-top: 0.25rem;">
                  <%= g.notes.length > 120 ? g.notes.slice(0, 120) + "…" : g.notes %>
                </div>
              <% } %>
            </div>
            <div class="admin-row-actions">
              <form action="/admin/reviews/<%= g.id %>/delete" method="POST" onsubmit="return confirm('Delete this review permanently?');">
                <button class="nav-btn" type="submit" style="color: var(--danger); border-color: var(--danger);">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Recent comments -->
      <div class="page-header" style="margin-top: 2rem;">
        <div>
          <h2 style="font-size: 1.2rem; margin: 0; font-weight: 700;">Recent comments</h2>
        </div>
      </div>
      <div class="admin-table">
        <% (recentComments || []).forEach(function(c) { %>
          <div class="admin-row">
            <div class="admin-row-main">
              <div class="admin-row-title">
                <% if (c.username) { %>
                  <a href="/u/<%= c.username %>" style="color: var(--accent);"><%= c.display_name || c.username %></a>
                <% } else { %>
                  user #<%= c.user_id %>
                <% } %>
                <span class="admin-muted">on <a href="/review/<%= c.review_id %>" style="color: var(--accent);">review #<%= c.review_id %></a></span>
              </div>
              <div class="admin-muted"><%= c.content %></div>
            </div>
            <div class="admin-row-actions">
              <form action="/admin/comments/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Delete this comment?');">
                <button class="nav-btn" type="submit" style="color: var(--danger); border-color: var(--danger);">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Users -->
      <div class="page-header" style="margin-top: 2rem;">
        <div>
          <h2 style="font-size: 1.2rem; margin: 0; font-weight: 700;">Users</h2>
        </div>
      </div>
      <div class="admin-table">
        <% (users || []).forEach(function(u) { %>
          <div class="admin-row">
            <div class="admin-row-main">
              <div class="admin-row-title">
                <% if (u.username) { %>
                  <a href="/u/<%= u.username %>" style="color: inherit;"><%= u.display_name || u.username %></a>
                  <span class="admin-muted">@<%= u.username %></span>
                <% } else { %>
                  <%= u.email %>
                <% } %>
                <% if (u.is_admin) { %><span class="xp-reward-chip">admin</span><% } %>
                <% if (u.is_banned) { %><span class="xp-reward-chip" style="border-color: var(--danger); color: #ff8a8a;">banned</span><% } %>
              </div>
              <div class="admin-muted"><%= u.email %> · <%= u.total_xp %> XP</div>
            </div>
            <div class="admin-row-actions">
              <% if (!u.is_admin) { %>
                <% if (u.is_banned) { %>
                  <form action="/admin/users/<%= u.id %>/unban" method="POST">
                    <button class="nav-btn nav-btn-primary" type="submit">Unban</button>
                  </form>
                <% } else { %>
                  <form action="/admin/users/<%= u.id %>/ban" method="POST" onsubmit="return confirm('Ban this user?');">
                    <button class="nav-btn" type="submit" style="color: var(--danger); border-color: var(--danger);">Ban</button>
                  </form>
                <% } %>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
      <script src="/js/nav.js"></script>
  </body>
</html>
