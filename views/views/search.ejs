<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Search Games – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>Search</h1>
          <p>Find games or people on the site</p>
        </div>
      </div>

      <div class="follow-tabs" style="max-width: 640px;">
        <button type="button" class="follow-tab active" data-mode="games" id="tab-games">Games</button>
        <button type="button" class="follow-tab" data-mode="users" id="tab-users">Users</button>
      </div>

      <div class="form-card" style="max-width: 640px; margin-bottom: 1.5rem;">
        <div class="mb-0">
          <input
            class="form-control"
            type="text"
            id="site-search"
            placeholder="Search games…"
            autocomplete="off"
            value="<%= typeof query !== 'undefined' ? query : '' %>"
          />
          <div id="search-status" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;"></div>
        </div>
      </div>

      <div id="search-results" class="search-results-page"></div>

      <% if (typeof localGames !== "undefined" && localGames && localGames.length) { %>
        <div class="page-header" style="margin-top: 1.5rem;">
          <div>
            <h2 style="font-size: 1.15rem; margin: 0;">Reviewed on this site</h2>
            <p style="margin: 0.2rem 0 0; color: var(--text-muted); font-size: 0.9rem;">
              Games people have already reviewed
            </p>
          </div>
        </div>
        <div class="user-list">
          <% localGames.forEach(function(g) { %>
            <a href="/game/<%= g.game_id %>" class="user-list-item" style="text-decoration: none; color: inherit;">
              <div class="user-list-main">
                <% if (g.cover_url) { %>
                  <img class="user-list-avatar" src="<%= g.cover_url %>" alt="" style="border-radius: 8px;" />
                <% } else { %>
                  <div class="user-list-avatar user-list-avatar-placeholder" style="border-radius: 8px;">?</div>
                <% } %>
                <div>
                  <div class="user-list-name"><%= g.title %></div>
                  <div class="user-list-handle">
                    <%= g.review_count %> review<%= g.review_count === 1 ? "" : "s" %>
                    · avg <%= g.avg_rating !== null ? Number(g.avg_rating).toFixed(1) : "—" %>
                  </div>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

    <script>
      let mode = "games";
      const searchInput = document.getElementById("site-search");
      const resultsEl = document.getElementById("search-results");
      const statusEl = document.getElementById("search-status");
      let debounceTimer = null;

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      document.getElementById("tab-games").addEventListener("click", () => setMode("games"));
      document.getElementById("tab-users").addEventListener("click", () => setMode("users"));

      function setMode(m) {
        mode = m;
        document.getElementById("tab-games").classList.toggle("active", m === "games");
        document.getElementById("tab-users").classList.toggle("active", m === "users");
        searchInput.placeholder = m === "games" ? "Search games…" : "Search users by name or @username…";
        resultsEl.innerHTML = "";
        statusEl.textContent = "";
        if (searchInput.value.trim().length >= 2) runSearch();
        searchInput.focus();
      }

      function renderGames(results) {
        resultsEl.innerHTML = results
          .map(
            (g) => `
          <a href="/game/${g.id}" class="search-result-item" style="text-decoration:none;">
            ${g.cover ? `<img src="${g.cover}" alt="" />` : `<div class="search-result-placeholder"></div>`}
            <div>
              <div class="search-result-name">${escapeHtml(g.name)}</div>
              <div class="search-result-meta">${g.released ? new Date(g.released).getFullYear() : "—"}</div>
            </div>
          </a>`
          )
          .join("");
      }

      function renderUsers(results) {
        resultsEl.innerHTML = results
          .map(
            (u) => `
          <a href="/u/${escapeHtml(u.username)}" class="search-result-item" style="text-decoration:none;">
            ${
              u.avatar_url
                ? `<img src="${escapeHtml(u.avatar_url)}" alt="" style="border-radius:50%;object-fit:cover;" />`
                : `<div class="search-result-placeholder" style="border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);">${escapeHtml(
                    (u.display_name || u.username || "?").charAt(0).toUpperCase()
                  )}</div>`
            }
            <div>
              <div class="search-result-name">${escapeHtml(u.display_name || u.username)}</div>
              <div class="search-result-meta">@${escapeHtml(u.username)}${u.bio ? " · " + escapeHtml(u.bio.slice(0, 60)) : ""}</div>
            </div>
          </a>`
          )
          .join("");
      }

      async function runSearch() {
        const q = searchInput.value.trim();
        if (q.length < 2) {
          resultsEl.innerHTML = "";
          statusEl.textContent = "";
          return;
        }
        statusEl.textContent = "Searching…";
        try {
          const url =
            mode === "games"
              ? "/api/games/search?q=" + encodeURIComponent(q)
              : "/api/users/search?q=" + encodeURIComponent(q.replace(/^@/, ""));
          const res = await fetch(url);
          const data = await res.json();
          if (!res.ok) {
            statusEl.textContent = data.error || "Search failed";
            resultsEl.innerHTML = "";
            return;
          }
          const results = data.results || [];
          statusEl.textContent = results.length
            ? results.length + " result" + (results.length === 1 ? "" : "s")
            : "No results";
          if (mode === "games") renderGames(results);
          else renderUsers(results);
        } catch (err) {
          statusEl.textContent = "Search error";
          resultsEl.innerHTML = "";
        }
      }

      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runSearch, 300);
      });

      if (searchInput.value.trim().length >= 2) runSearch();
    </script>

      <script src="/js/nav.js"></script>
  </body>
</html>
