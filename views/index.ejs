<!DOCTYPE html>
<html lang="en">
  <head>
    <title>GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <!-- Navbar -->
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header feed-page-header">
        <div>
          <h1><%= (typeof feedMode !== "undefined" && feedMode === "feed") ? "Your Feed" : "Explore" %></h1>
          <p>
            <% if (typeof feedMode !== "undefined" && feedMode === "feed") { %>
              Reviews from you and people you follow
            <% } else { %>
              Discover reviews from the community
            <% } %>
            <% if (userInfo && userInfo.length) { %>
              · <%= userInfo.length %> review<%= userInfo.length === 1 ? "" : "s" %>
            <% } %>
          </p>
        </div>
        <div class="feed-page-controls">
          <div class="feed-mode-tabs">
            <a href="/feed" class="feed-mode-tab<%= (typeof feedMode !== "undefined" && feedMode === "feed") ? " active" : "" %>">Feed</a>
            <a href="/explore" class="feed-mode-tab<%= (typeof feedMode === "undefined" || feedMode !== "feed") ? " active" : "" %>">Explore</a>
          </div>
          <div class="page-sort" id="sort-menu-wrap">
            <button type="button" class="page-sort-btn" id="sort-menu-btn" aria-expanded="false" aria-haspopup="true" aria-controls="sort-menu">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 6h18M6 12h12M10 18h4"/>
              </svg>
              <span id="sort-label">Sort</span>
            </button>
            <div id="sort-menu" class="nav-dropdown page-sort-dropdown" role="menu" hidden>
              <button type="button" class="sort-option" data-sort="likes" role="menuitem">Most likes</button>
              <button type="button" class="sort-option" data-sort="comments" role="menuitem">Most comments</button>
              <button type="button" class="sort-option" data-sort="new" role="menuitem">Newest</button>
            </div>
          </div>
        </div>
      </div>

      <% if (!userInfo || userInfo.length === 0) { %>
        <div class="empty-state">
          <% if (typeof feedMode !== "undefined" && feedMode === "feed") { %>
            <h2>Your feed is empty</h2>
            <p>Follow some people or add your first review to get started.</p>
            <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
              <a href="/explore" class="nav-btn">Explore reviews</a>
              <a href="/add" class="nav-btn nav-btn-primary">+ Add Review</a>
            </div>
          <% } else { %>
            <h2>No reviews yet</h2>
            <p>Be the first to add a game review.</p>
            <a href="/add" class="nav-btn nav-btn-primary">+ Add Review</a>
          <% } %>
        </div>
      <% } else { %>
        <div class="game-list" id="feed-review-list">
          <% for (let i = 0; i < userInfo.length; i++) { %>
            <%- include("partials/game.ejs", { i: i }) %>
          <% } %>
        </div>
      <% } %>
    </div>
<script>
      function toggleNotes(id) {
        const notes = document.getElementById("notes-" + id);
        const btn = document.getElementById("expand-" + id);
        if (notes.classList.contains("clamped")) {
          notes.classList.remove("clamped");
          btn.textContent = "Show less";
        } else {
          notes.classList.add("clamped");
          btn.textContent = "Read more";
        }
      }

      function startEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "none";
        document.getElementById("edit-form-" + id).style.display = "block";
        const actions = document.querySelector("#comment-" + id + " .comment-actions");
        if (actions) actions.style.display = "none";
      }

      function cancelEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "block";
        document.getElementById("edit-form-" + id).style.display = "none";
        const actions = document.querySelector("#comment-" + id + " .comment-actions");
        if (actions) actions.style.display = "flex";
      }
    </script>
      <script src="/js/likes.js"></script>
    <script src="/js/report.js"></script>
    <script src="/js/comments.js"></script>
      
    <script>
      (function () {
        const list = document.getElementById("feed-review-list");
        const menu = document.getElementById("sort-menu");
        const btn = document.getElementById("sort-menu-btn");
        const label = document.getElementById("sort-label");
        if (!list || !menu || !btn) return;

        const labels = { likes: "Most likes", comments: "Most comments", new: "Newest" };

        function liveLikes(card) {
          const el = card.querySelector(".like-count");
          if (el) {
            const n = parseInt(el.textContent, 10);
            if (!Number.isNaN(n)) return n;
          }
          return parseInt(card.dataset.likes || "0", 10) || 0;
        }

        function liveComments(card) {
          const section = card.querySelector(".comments-section");
          if (section) {
            const count = section.querySelectorAll(".comment-item, .comment").length;
            if (count) return count;
          }
          return parseInt(card.dataset.comments || "0", 10) || 0;
        }

        function sortBy(mode) {
          const cards = Array.from(list.querySelectorAll(".game-card"));
          cards.sort((a, b) => {
            if (mode === "likes") return liveLikes(b) - liveLikes(a);
            if (mode === "comments") return liveComments(b) - liveComments(a);
            // newest: higher review id first
            return (parseInt(b.dataset.created || b.dataset.reviewId || "0", 10) || 0) -
                   (parseInt(a.dataset.created || a.dataset.reviewId || "0", 10) || 0);
          });
          cards.forEach((c) => list.appendChild(c));
          if (label) label.textContent = labels[mode] || "Sort";
          menu.hidden = true;
          btn.setAttribute("aria-expanded", "false");
          try { localStorage.setItem("gc-feed-sort", mode); } catch (e) {}
        }

        menu.querySelectorAll(".sort-option").forEach((opt) => {
          opt.addEventListener("click", () => sortBy(opt.dataset.sort));
        });

        try {
          const saved = localStorage.getItem("gc-feed-sort");
          if (saved && labels[saved]) sortBy(saved);
        } catch (e) {}
      })();
    </script>

      <script src="/js/nav.js"></script>
  </body>
</html>