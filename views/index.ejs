<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game Blog</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand navbar-custom fixed-top">
      <div class="container-fluid px-4">
        <a class="navbar-brand" href="/">Video Game <span>Blog</span></a>

        <div class="d-flex align-items-center gap-2">
          <!-- Sort dropdown -->
          <div class="dropdown">
            <button
              class="nav-btn dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              Sort
            </button>
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
              <form action="/sort" method="post">
                <li>
                  <button class="dropdown-item" type="submit" name="sort" value="rating">
                    Rating
                  </button>
                </li>
                <li>
                  <button class="dropdown-item" type="submit" name="sort" value="completed">
                    Completed
                  </button>
                </li>
                <li>
                  <button class="dropdown-item" type="submit" name="sort" value="released">
                    Released
                  </button>
                </li>
              </form>
            </ul>
          </div>

          <a href="/add" class="nav-btn nav-btn-primary">+ Add Review</a>

          <% if (typeof userlog !== "undefined" && userlog) { %>
            <a href="/logout" class="nav-btn">Logout</a>
          <% } else { %>
            <a href="/login" class="nav-btn">Login</a>
          <% } %>
        </div>
      </div>
    </nav>

    <div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>My Reviews</h1>
          <p>
            <% if (userInfo && userInfo.length) { %>
              <%= userInfo.length %> game<%= userInfo.length === 1 ? "" : "s" %> reviewed
            <% } else { %>
              No reviews yet
            <% } %>
          </p>
        </div>
      </div>

      <% if (!userInfo || userInfo.length === 0) { %>
        <div class="empty-state">
          <h2>No reviews yet</h2>
          <p>Add your first game review to get started.</p>
          <a href="/add" class="nav-btn nav-btn-primary">+ Add Review</a>
        </div>
      <% } else { %>
        <div class="game-list">
          <% for (let i = 0; i < userInfo.length; i++) { %>
            <%- include("partials/game.ejs", { i: i }) %>
          <% } %>
        </div>
      <% } %>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script>
      function toggleNotes(id) {
        const notes = document.getElementById("notes-" + id);
        const btn = document.getElementById("expand-" + id);
        if (notes.classList.contains("clamped")) {
          notes.classList.remove("clamped");
          btn.textContent = "Show less";
        } else {
          notes.classList.add("clamped");
          btn.textContent = "Read more";
        }
      }

      function startEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "none";
        document.getElementById("edit-form-" + id).style.display = "block";
        const actions = document.querySelector("#comment-" + id + " .comment-actions");
        if (actions) actions.style.display = "none";
      }

      function cancelEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "block";
        document.getElementById("edit-form-" + id).style.display = "none";
        const actions = document.querySelector("#comment-" + id + " .comment-actions");
        if (actions) actions.style.display = "flex";
      }
    </script>
  </body>
</html>