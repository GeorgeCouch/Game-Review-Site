<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= gameTitle %> – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="game-page-header">
        <% if (coverUrl) { %>
          <img class="game-page-cover" src="<%= coverUrl %>" alt="<%= gameTitle %> cover" />
        <% } else { %>
          <div class="game-page-cover game-page-cover-placeholder">No cover</div>
        <% } %>

        <div class="game-page-info">
          <h1 class="game-page-title"><%= gameTitle %></h1>
          <% if (released) { %>
            <p class="game-page-meta">Released <%= released %></p>
          <% } %>

          <div class="community-score">
            <div class="community-score-value">
              <%= avgRating !== null ? Number(avgRating).toFixed(1) : "—" %>
            </div>
            <div class="community-score-label">
              Community score
              <span class="community-score-sub">
                <%= reviewCount %> review<%= reviewCount === 1 ? "" : "s" %>
              </span>
            </div>
          </div>

          <% if (typeof userlog !== "undefined" && userlog) { %>
            <div class="status-buttons">
              <form action="/game/<%= gameId %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="title" value="<%= gameTitle %>" />
                <input type="hidden" name="cover_url" value="<%= coverUrl || '' %>" />
                <input type="hidden" name="released" value="<%= released || '' %>" />
                <input type="hidden" name="status" value="want" />
                <button type="submit" class="status-btn<%= userStatus === 'want' ? ' active' : '' %>">Want to Play</button>
              </form>
              <form action="/game/<%= gameId %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="title" value="<%= gameTitle %>" />
                <input type="hidden" name="cover_url" value="<%= coverUrl || '' %>" />
                <input type="hidden" name="released" value="<%= released || '' %>" />
                <input type="hidden" name="status" value="playing" />
                <button type="submit" class="status-btn<%= userStatus === 'playing' ? ' active' : '' %>">Playing</button>
              </form>
              <form action="/game/<%= gameId %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="title" value="<%= gameTitle %>" />
                <input type="hidden" name="cover_url" value="<%= coverUrl || '' %>" />
                <input type="hidden" name="released" value="<%= released || '' %>" />
                <input type="hidden" name="status" value="played" />
                <button type="submit" class="status-btn<%= userStatus === 'played' ? ' active' : '' %>">Played</button>
              </form>
              <% if (userStatus) { %>
                <form action="/game/<%= gameId %>/status" method="POST" style="display:inline;">
                  <input type="hidden" name="status" value="" />
                  <button type="submit" class="status-btn status-btn-clear" title="Clear status">✕</button>
                </form>
              <% } %>
            </div>
            <button
              type="button"
              class="nav-btn nav-btn-primary"
              style="margin-top: 0.75rem; display: inline-block;"
              data-open-review-modal
              data-game-id="<%= gameId %>"
              data-game-name="<%= gameTitle %>"
              data-game-cover="<%= coverUrl || '' %>"
              data-game-released="<%= released || '' %>"
            >
              + Review this game
            </button>
          <% } else { %>
            <a href="/login" class="nav-btn nav-btn-primary" style="margin-top: 0.75rem; display: inline-block;">
              Log in to track / review
            </a>
          <% } %>
        </div>
      </div>

      
      <% if (typeof fansAlsoLiked !== "undefined" && fansAlsoLiked && fansAlsoLiked.length) { %>
        <section class="yir-section" style="margin-top: 1.5rem;">
          <h2 style="font-size: 1.1rem;">Fans also liked</h2>
          <div class="fans-also-grid">
            <% fansAlsoLiked.forEach(function(g) { %>
              <a href="/game/<%= g.game_id %>" class="fans-also-card">
                <% if (g.cover_url) { %>
                  <img src="<%= g.cover_url %>" alt="" />
                <% } else { %>
                  <div class="fans-also-fallback"><%= (g.title || "?").charAt(0) %></div>
                <% } %>
                <div class="fans-also-meta">
                  <div class="fans-also-title"><%= g.title %></div>
                  <div class="fans-also-sub">
                    <%= g.shared_reviewers %> shared
                    <% if (g.avg_rating != null) { %> · <%= Number(g.avg_rating).toFixed(1) %>★ <% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

<% if (typeof topStream !== "undefined" && topStream) { %>
        <div class="twitch-embed-section" style="margin-top: 1.5rem;">
          <div class="twitch-embed-header">
            <span class="live-badge">LIVE</span>
            <span class="twitch-embed-title">#1 stream · <%= topStream.user_name %></span>
            <span class="twitch-embed-meta">
              <%= topStream.viewer_count?.toLocaleString?.() || topStream.viewer_count %> viewers
            </span>
          </div>
          <p class="twitch-stream-title"><%= topStream.title %></p>
          <div class="twitch-embed-wrap">
            <iframe
              src="https://player.twitch.tv/?channel=<%= topStream.user_login %>&parent=<%= twitchParent %>&muted=true"
              allowfullscreen
              scrolling="no"
              frameborder="0"
              allow="autoplay; fullscreen"
              title="Top Twitch stream"
            ></iframe>
          </div>
          <a href="https://twitch.tv/<%= topStream.user_login %>" target="_blank" rel="noopener" class="nav-btn" style="margin-top: 0.75rem; display: inline-block;">
            Watch on Twitch
          </a>
        </div>
      <% } %>

      <div class="page-header" style="margin-top: 2rem; display:flex; justify-content:space-between; align-items:flex-end; gap:1rem; flex-wrap:wrap;">
        <div>
          <h2 style="font-size: 1.25rem; margin: 0; font-weight: 700;">Top reviews</h2>
          <p style="margin: 0.2rem 0 0; color: var(--text-muted); font-size: 0.9rem;">
            <% if (reviewCount) { %>
              Showing top <%= Math.min(5, userInfo ? userInfo.length : 0) %> of <%= reviewCount %> by likes
            <% } else { %>
              No reviews yet
            <% } %>
          </p>
        </div>
        <% if (reviewCount) { %>
          <a href="/game/<%= gameId %>/reviews" class="nav-btn nav-btn-primary">Read all reviews</a>
        <% } %>
      </div>

      <% if (!userInfo || userInfo.length === 0) { %>
        <div class="empty-state">
          <h2>No reviews yet</h2>
          <p>Be the first to review this game.</p>
          <% if (typeof userlog !== "undefined" && userlog) { %>
            <a href="/log" class="nav-btn nav-btn-primary">+ Log</a>
          <button type="button" class="nav-btn" data-open-review-modal data-game-id="<%= gameId %>" data-game-name="<%= gameTitle %>" data-game-cover="<%= coverUrl || '' %>" data-game-released="<%= released || '' %>">Review</button>
          <% } %>
        </div>
      <% } else { %>
        <div class="game-list">
          <% for (let i = 0; i < userInfo.length; i++) { %>
            <%- include("partials/game.ejs", { i: i }) %>
          <% } %>
        </div>
      <% } %>
    </div>
<script src="/js/likes.js"></script>
    <script src="/js/report.js"></script>
    <script src="/js/comments.js"></script>
    <script>
      function toggleNotes(id) {
        const notes = document.getElementById("notes-" + id);
        const btn = document.getElementById("expand-" + id);
        if (notes.classList.contains("clamped")) {
          notes.classList.remove("clamped");
          btn.textContent = "Show less";
        } else {
          notes.classList.add("clamped");
          btn.textContent = "Read more";
        }
      }
      function startEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "none";
        document.getElementById("edit-form-" + id).style.display = "block";
      }
      function cancelEditComment(id) {
        document.getElementById("comment-body-" + id).style.display = "block";
        document.getElementById("edit-form-" + id).style.display = "none";
      }
    </script>
      <script src="/js/nav.js"></script>
  </body>
</html>
