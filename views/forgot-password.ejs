<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Forgot password – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: null, showSort: false }) %>
    <div class="page-wrapper">
      <div class="form-card auth-card">
        <h1>Account recovery</h1>
        <p class="auth-sub">We’ll email you a link to reset your password</p>
        <% if (typeof error !== "undefined" && error) { %>
          <div class="auth-alert auth-alert-error"><%= error %></div>
        <% } %>
        <% if (typeof info !== "undefined" && info) { %>
          <div class="auth-alert auth-alert-info"><%= info %></div>
        <% } %>
        <form action="/forgot-password" method="POST">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" placeholder="you@example.com" required />
          </div>
          <button type="submit" class="btn-submit">Send reset link</button>
        </form>
        <p class="auth-footer"><a href="/login">Back to login</a></p>
      </div>
    </div>
    <script src="/js/nav.js"></script>
  </body>
</html>
