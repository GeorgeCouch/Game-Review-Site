<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – GameCouch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="form-card">
        <h1>Create Account</h1>

        <% if (typeof error !== "undefined" && error) { %>
          <div style="background: rgba(255,92,92,0.15); border: 1px solid var(--danger); color: #ff8a8a; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <%= error %>
          </div>
        <% } %>

        <form action="/register" method="POST">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text" style="background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); border-radius: 10px 0 0 10px;">@</span>
              <input
                class="form-control"
                type="text"
                name="handle"
                placeholder="coolgamer42"
                pattern="[a-z][a-z0-9_]{2,29}"
                title="3–30 characters. Start with a letter. Only lowercase letters, numbers, and underscores."
                required
                style="border-radius: 0 10px 10px 0;"
              />
            </div>
            <small style="color: var(--text-muted); font-size: 0.8rem;">
              This will be your public @username
            </small>
          </div>

          <div class="mb-3">
            <label class="form-label">Display Name</label>
            <input
              class="form-control"
              type="text"
              name="display_name"
              placeholder="How you want to appear"
              maxlength="100"
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Email</label>
            <input
              class="form-control"
              type="email"
              name="username"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              class="form-control"
              type="password"
              name="password"
              required
              minlength="6"
            />
          </div>

          <button type="submit" class="btn-submit">Register</button>
        </form>

        <p style="text-align: center; margin-top: 1.25rem; color: var(--text-muted); font-size: 0.9rem;">
          Already have an account?
          <a href="/login" style="color: var(--accent);">Login</a>
        </p>
      </div>
    </div>
      <script src="/js/nav.js"></script>
  </body>
</html>
