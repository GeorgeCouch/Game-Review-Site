<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quick Log – GameCouch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="form-card" style="max-width: 520px;">
        <h1>Quick Log</h1>
        <p style="color: var(--text-muted); margin: -0.5rem 0 1.25rem; font-size: 0.9rem;">
          Rate a game and mark when you finished — no write-up required.
        </p>

        <% if (typeof error !== "undefined" && error) { %>
          <div style="background: rgba(255,92,92,0.15); border: 1px solid var(--danger); color: #ff8a8a; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <%= error %>
          </div>
        <% } %>

        <form action="/log-game" method="POST" id="log-form">
          <div class="mb-3">
            <label class="form-label">Search for a game</label>
            <input
              class="form-control"
              type="text"
              id="game-search"
              placeholder="Start typing a game title…"
              autocomplete="off"
            />
            <div id="search-status" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;"></div>
            <div id="search-results" class="search-results"></div>
          </div>

          <div id="selected-game" class="selected-game" style="display: none;">
            <img id="selected-cover" src="" alt="" />
            <div>
              <div id="selected-title" class="selected-title"></div>
              <div id="selected-year" class="selected-year"></div>
              <button type="button" class="nav-btn" style="margin-top: 0.5rem; padding: 0.25rem 0.75rem; font-size: 0.8rem;" id="clear-selection">
                Change game
              </button>
            </div>
          </div>

          <input type="hidden" name="game_id" id="field-game-id" required />
          <input type="hidden" name="title" id="field-title" />
          <input type="hidden" name="cover_url" id="field-cover" />
          <input type="hidden" name="released" id="field-released" />
          <input type="hidden" name="rating" id="field-rating" value="" />

          <div class="mb-3">
            <label class="form-label">Your rating</label>
            <div class="quick-stars" id="quick-stars" role="group" aria-label="Rating">
              <% for (let s = 1; s <= 5; s++) { %>
                <button type="button" class="quick-star" data-value="<%= s %>" aria-label="<%= s %> stars">★</button>
              <% } %>
              <span class="quick-star-label" id="rating-label">Tap a star</span>
            </div>
            <div class="half-row">
              <label class="half-check">
                <input type="checkbox" id="half-star" />
                +½ star
              </label>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Completed</label>
            <input class="form-control" type="date" name="completed" id="field-completed" />
            <small style="color: var(--text-muted); font-size: 0.8rem;">Optional — defaults to today if left blank</small>
          </div>

          <div class="mb-3">
            <label class="form-label" style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
              <input type="checkbox" name="mark_played" value="1" checked style="width:auto;" />
              Also mark as <strong>Played</strong>
            </label>
          </div>

          <button type="submit" class="btn-submit" id="submit-btn" disabled>Log game</button>
          <p style="text-align:center; margin-top: 0.85rem; font-size: 0.85rem; color: var(--text-muted);">
            Want to write more? <a href="/add" style="color: var(--accent);">Full review</a>
          </p>
        </form>
      </div>
    </div>

    <script>
      const searchInput = document.getElementById("game-search");
      const resultsEl = document.getElementById("search-results");
      const statusEl = document.getElementById("search-status");
      const selectedEl = document.getElementById("selected-game");
      const submitBtn = document.getElementById("submit-btn");
      const ratingField = document.getElementById("field-rating");
      const ratingLabel = document.getElementById("rating-label");
      const halfStar = document.getElementById("half-star");
      let debounceTimer = null;
      let starValue = 0;

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function updateRating() {
        let val = starValue;
        if (val > 0 && halfStar.checked && val < 5) val += 0.5;
        ratingField.value = val > 0 ? val.toFixed(1) : "";
        ratingLabel.textContent = val > 0 ? val.toFixed(1) + " / 5" : "Tap a star";
        document.querySelectorAll(".quick-star").forEach((btn) => {
          const v = parseInt(btn.dataset.value, 10);
          btn.classList.toggle("active", v <= starValue);
        });
        maybeEnable();
      }

      function maybeEnable() {
        const hasGame = !!document.getElementById("field-game-id").value;
        const hasRating = !!ratingField.value;
        submitBtn.disabled = !(hasGame && hasRating);
      }

      document.querySelectorAll(".quick-star").forEach((btn) => {
        btn.addEventListener("click", () => {
          starValue = parseInt(btn.dataset.value, 10);
          updateRating();
        });
      });
      halfStar.addEventListener("change", updateRating);

      // Default completed = today
      const completedInput = document.getElementById("field-completed");
      const today = new Date();
      completedInput.value = today.toISOString().slice(0, 10);

      function selectGame(game) {
        document.getElementById("field-game-id").value = game.id;
        document.getElementById("field-title").value = game.name;
        document.getElementById("field-cover").value = game.cover || "";
        document.getElementById("field-released").value = game.released || "";
        document.getElementById("selected-title").textContent = game.name;
        document.getElementById("selected-year").textContent = game.released
          ? new Date(game.released).getFullYear()
          : "Unknown year";
        const coverImg = document.getElementById("selected-cover");
        if (game.cover) {
          coverImg.src = game.cover;
          coverImg.style.display = "block";
        } else {
          coverImg.style.display = "none";
        }
        selectedEl.style.display = "flex";
        searchInput.style.display = "none";
        resultsEl.innerHTML = "";
        statusEl.textContent = "";
        maybeEnable();
      }

      document.getElementById("clear-selection").addEventListener("click", () => {
        selectedEl.style.display = "none";
        searchInput.style.display = "block";
        searchInput.value = "";
        searchInput.focus();
        document.getElementById("field-game-id").value = "";
        document.getElementById("field-title").value = "";
        document.getElementById("field-cover").value = "";
        document.getElementById("field-released").value = "";
        maybeEnable();
      });

      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        const q = searchInput.value.trim();
        if (q.length < 2) {
          resultsEl.innerHTML = "";
          statusEl.textContent = "";
          return;
        }
        statusEl.textContent = "Searching…";
        debounceTimer = setTimeout(async () => {
          try {
            const res = await fetch("/api/games/search?q=" + encodeURIComponent(q));
            const data = await res.json();
            if (!res.ok) {
              statusEl.textContent = data.error || "Search failed";
              resultsEl.innerHTML = "";
              return;
            }
            const results = data.results || [];
            statusEl.textContent = results.length
              ? results.length + " result" + (results.length === 1 ? "" : "s")
              : "No games found";
            resultsEl.innerHTML = results
              .map(
                (g) => `
              <button type="button" class="search-result-item" data-id="${g.id}">
                ${g.cover ? `<img src="${g.cover}" alt="" />` : `<div class="search-result-placeholder"></div>`}
                <div>
                  <div class="search-result-name">${escapeHtml(g.name)}</div>
                  <div class="search-result-meta">${g.released ? new Date(g.released).getFullYear() : "—"}</div>
                </div>
              </button>`
              )
              .join("");
            resultsEl.querySelectorAll(".search-result-item").forEach((btn) => {
              btn.addEventListener("click", () => {
                const id = parseInt(btn.dataset.id, 10);
                const game = results.find((x) => x.id === id);
                if (game) selectGame(game);
              });
            });
          } catch (err) {
            statusEl.textContent = "Search error";
            resultsEl.innerHTML = "";
          }
        }, 300);
      });
    </script>
      <script src="/js/nav.js"></script>
  </body>
</html>
