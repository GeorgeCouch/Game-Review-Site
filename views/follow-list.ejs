<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= listTitle %> – @<%= profile.username %> – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1><%= listTitle %></h1>
          <p>
            <a href="/u/<%= profile.username %>" style="color: var(--accent);">@<%= profile.username %></a>
            · <%= users.length %> user<%= users.length === 1 ? "" : "s" %>
          </p>
        </div>
      </div>

      <!-- Tabs -->
      <div class="follow-tabs">
        <a
          href="/u/<%= profile.username %>/followers"
          class="follow-tab<%= listType === 'followers' ? ' active' : '' %>"
        >Followers</a>
        <a
          href="/u/<%= profile.username %>/following"
          class="follow-tab<%= listType === 'following' ? ' active' : '' %>"
        >Following</a>
        <% if (!(typeof userlog !== "undefined" && userlog && userlog.id === profile.id)) { %>
        <a
          href="/u/<%= profile.username %>/mutual"
          class="follow-tab<%= listType === 'mutual' ? ' active' : '' %>"
        >Mutual Following</a>
        <% } %>
      </div>

      <% if (!users || users.length === 0) { %>
        <div class="empty-state">
          <h2>No one here yet</h2>
          <p>
            <% if (listType === 'followers') { %>
              Nobody is following <%= profile.display_name || profile.username %> yet.
            <% } else if (listType === 'mutual') { %>
              No mutual follows to show yet.
            <% } else { %>
              <%= profile.display_name || profile.username %> isn’t following anyone yet.
            <% } %>
          </p>
        </div>
      <% } else { %>
        <div class="user-list">
          <% users.forEach(function(u) { %>
            <div class="user-list-item">
              <a href="/u/<%= u.username %>" class="user-list-main">
                <% if (u.avatar_url) { %>
                  <img class="user-list-avatar" src="<%= u.avatar_url %>" alt="" />
                <% } else { %>
                  <div class="user-list-avatar user-list-avatar-placeholder">
                    <%= (u.display_name || u.username || "?").charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <div>
                  <div class="user-list-name"><%= u.display_name || u.username %></div>
                  <div class="user-list-handle">@<%= u.username %></div>
                  <% if (u.bio) { %>
                    <div class="user-list-bio"><%= u.bio.length > 100 ? u.bio.slice(0, 100) + "…" : u.bio %></div>
                  <% } %>
                </div>
              </a>

              <% if (typeof userlog !== "undefined" && userlog && userlog.id !== u.id) { %>
                <% if (u.is_followed_by_me) { %>
                  <form action="/unfollow/<%= u.username %>" method="POST">
                    <button type="submit" class="nav-btn">Unfollow</button>
                  </form>
                <% } else { %>
                  <form action="/follow/<%= u.username %>" method="POST">
                    <button type="submit" class="nav-btn nav-btn-primary">Follow</button>
                  </form>
                <% } %>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
      <script src="/js/nav.js"></script>
  </body>
</html>
