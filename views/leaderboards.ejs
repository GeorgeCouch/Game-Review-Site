<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Leaderboards – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
    <div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>Leaderboards</h1>
          <p>Live rankings from the community · updates with every review and like</p>
        </div>
      </div>

      <div class="lb-grid">
        <%
          function medal(i) {
            if (i === 0) return " lb-row-gold";
            if (i === 1) return " lb-row-silver";
            if (i === 2) return " lb-row-bronze";
            return "";
          }
          function medalRank(i) {
            if (i === 0) return " lb-rank-gold";
            if (i === 1) return " lb-rank-silver";
            if (i === 2) return " lb-rank-bronze";
            return "";
          }
          const boards = [
            {
              id: "rated",
              title: "Highest rated",
              subtitle: "Min. " + minReviews + " reviews · by community average",
              searchPh: "Search games…",
              empty: "Not enough reviews yet.",
              items: topRated || [],
              kind: "game",
              scoreKey: "avg_rating",
              scoreFmt: "rating",
              metaFmt: "reviews"
            },
            {
              id: "reviewed",
              title: "Most reviewed",
              subtitle: "Games with the most community reviews",
              searchPh: "Search games…",
              empty: "No reviews yet.",
              items: mostReviewed || [],
              kind: "game",
              scoreKey: "review_count",
              scoreFmt: "int",
              metaFmt: "avg"
            },
            {
              id: "active",
              title: "Most active reviewers",
              subtitle: "By number of reviews written",
              searchPh: "Search people…",
              empty: "No reviewers yet.",
              items: topReviewers || [],
              kind: "user",
              scoreKey: "review_count",
              scoreFmt: "int",
              metaFmt: "handle"
            },
            {
              id: "liked",
              title: "Most liked reviewers",
              subtitle: "Total likes received on their reviews",
              searchPh: "Search people…",
              empty: "No likes yet.",
              items: topLiked || [],
              kind: "user",
              scoreKey: "likes_count",
              scoreFmt: "int",
              metaFmt: "handle"
            },
            {
              id: "completed",
              title: "Completions in " + year,
              subtitle: "Most games finished this year",
              searchPh: "Search people…",
              empty: "No completions logged this year.",
              items: topThisYear || [],
              kind: "user",
              scoreKey: "completed_count",
              scoreFmt: "int",
              metaFmt: "handle"
            },
            {
              id: "xp",
              title: "Highest XP",
              subtitle: "Players ranked by total experience",
              searchPh: "Search people…",
              empty: "No XP earned yet.",
              items: topXp || [],
              kind: "user",
              scoreKey: "total_xp",
              scoreFmt: "int",
              metaFmt: "handle"
            }
          ];
        %>

        <% boards.forEach(function(board) { %>
          <section class="lb-card" data-lb-card data-lb-board="<%= board.id %>">
            <div class="lb-card-top">
              <h2 class="lb-title"><%= board.title %></h2>
              <p class="lb-subtitle"><%= board.subtitle %></p>
            </div>

            <% if (!board.items.length) { %>
              <p class="lb-empty"><%= board.empty %></p>
              <div class="lb-card-footer">
                <button type="button" class="lb-expand-btn" disabled>Show all</button>
              </div>
            <% } else { %>
              <ol class="lb-list">
                <% board.items.slice(0, 5).forEach(function(item, i) { %>
                  <li class="lb-row<%= medal(i) %>">
                    <span class="lb-rank<%= medalRank(i) %>"><%= i + 1 %></span>
                    <% if (board.kind === "game") { %>
                      <a href="/game/<%= item.game_id %>" class="lb-main">
                        <% if (item.cover_url) { %>
                          <img src="<%= item.cover_url %>" alt="" class="lb-thumb" />
                        <% } else { %>
                          <div class="lb-thumb lb-thumb-placeholder">?</div>
                        <% } %>
                        <div class="lb-text">
                          <div class="lb-name"><%= item.title %></div>
                          <div class="lb-meta">
                            <% if (board.metaFmt === "reviews") { %>
                              <%= item.review_count %> review<%= item.review_count === 1 ? "" : "s" %>
                            <% } else { %>
                              avg <%= item.avg_rating != null ? Number(item.avg_rating).toFixed(1) : "—" %>
                            <% } %>
                          </div>
                        </div>
                      </a>
                    <% } else { %>
                      <a href="/u/<%= item.username %>" class="lb-main">
                        <% if (item.avatar_url) { %>
                          <img src="<%= item.avatar_url %>" alt="" class="lb-avatar" />
                        <% } else { %>
                          <div class="lb-avatar lb-avatar-placeholder"><%= (item.display_name || item.username || "?").charAt(0).toUpperCase() %></div>
                        <% } %>
                        <div class="lb-text">
                          <div class="lb-name"><%= item.display_name || item.username %></div>
                          <div class="lb-meta">@<%= item.username %></div>
                        </div>
                      </a>
                    <% } %>
                    <span class="lb-score">
                      <% if (board.scoreFmt === "rating") { %>
                        <%= Number(item[board.scoreKey]).toFixed(1) %>
                      <% } else { %>
                        <%= item[board.scoreKey] %>
                      <% } %>
                    </span>
                  </li>
                <% }) %>
              </ol>
              <div class="lb-card-footer">
                <button
                  type="button"
                  class="lb-expand-btn"
                  data-open-lb-modal
                  data-board="<%= board.id %>"
                  data-search-ph="<%= board.searchPh %>"
                  <%= board.items.length <= 5 ? "disabled" : "" %>
                >Show all</button>
              </div>
              <script type="application/json" id="lb-data-<%= board.id %>"><%-
                JSON.stringify(board.items.map(function(item, i) {
                  if (board.kind === "game") {
                    return {
                      rank: i + 1,
                      kind: "game",
                      href: "/game/" + item.game_id,
                      title: item.title || "",
                      meta: board.metaFmt === "reviews"
                        ? (item.review_count + " review" + (item.review_count === 1 ? "" : "s"))
                        : ("avg " + (item.avg_rating != null ? Number(item.avg_rating).toFixed(1) : "—")),
                      score: board.scoreFmt === "rating" ? Number(item.avg_rating).toFixed(1) : String(item[board.scoreKey]),
                      image: item.cover_url || null,
                      search: String(item.title || "").toLowerCase()
                    };
                  }
                  return {
                    rank: i + 1,
                    kind: "user",
                    href: "/u/" + item.username,
                    title: item.display_name || item.username || "",
                    meta: "@" + (item.username || ""),
                    score: String(item[board.scoreKey]),
                    image: item.avatar_url || null,
                    initial: String(item.display_name || item.username || "?").charAt(0).toUpperCase(),
                    search: String((item.display_name || "") + " " + (item.username || "")).toLowerCase()
                  };
                }))
              %></script>
            <% } %>
          </section>
        <% }) %>
      </div>
    </div>

    <div class="gc-modal" id="lb-modal" hidden aria-hidden="true">
      <div class="gc-modal-backdrop" data-close-lb-modal></div>
      <div class="gc-modal-dialog lb-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="lb-modal-title">
        <div class="gc-modal-header">
          <div>
            <h2 id="lb-modal-title">Leaderboard</h2>
            <p id="lb-modal-subtitle"></p>
          </div>
          <button type="button" class="gc-modal-close" data-close-lb-modal aria-label="Close">&times;</button>
        </div>
        <div class="gc-modal-body">
          <div class="lb-filter-bar lb-modal-filter">
            <input type="search" class="form-control" id="lb-modal-search" placeholder="Search…" autocomplete="off" />
          </div>
          <ol class="lb-list lb-modal-list" id="lb-modal-list"></ol>
          <div class="lb-pagination" id="lb-modal-pager"></div>
        </div>
      </div>
    </div>

    <script>
    (function () {
      var PAGE_SIZE = 10;
      var modal = document.getElementById("lb-modal");
      var titleEl = document.getElementById("lb-modal-title");
      var subEl = document.getElementById("lb-modal-subtitle");
      var searchEl = document.getElementById("lb-modal-search");
      var listEl = document.getElementById("lb-modal-list");
      var pagerEl = document.getElementById("lb-modal-pager");
      var current = [];
      var page = 1;
      var boardMeta = {};

      document.querySelectorAll("[data-lb-card]").forEach(function (card) {
        var id = card.getAttribute("data-lb-board");
        var title = card.querySelector(".lb-title");
        var sub = card.querySelector(".lb-subtitle");
        boardMeta[id] = {
          title: title ? title.textContent.trim() : "Leaderboard",
          subtitle: sub ? sub.textContent.trim() : ""
        };
      });

      function openModal() {
        modal.hidden = false;
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("gc-modal-open");
        modal.classList.remove("is-closing");
        void modal.offsetWidth;
        modal.classList.add("is-open");
      }

      function closeModal() {
        if (!modal || modal.hidden) return;
        modal.classList.remove("is-open");
        modal.classList.add("is-closing");
        var done = function () {
          modal.hidden = true;
          modal.classList.remove("is-closing");
          modal.setAttribute("aria-hidden", "true");
          document.body.classList.remove("gc-modal-open");
          modal.removeEventListener("animationend", done);
        };
        modal.addEventListener("animationend", done);
        setTimeout(done, 220);
      }

      function medalClass(rank) {
        if (rank === 1) return " lb-row-gold";
        if (rank === 2) return " lb-row-silver";
        if (rank === 3) return " lb-row-bronze";
        return "";
      }
      function medalRank(rank) {
        if (rank === 1) return " lb-rank-gold";
        if (rank === 2) return " lb-rank-silver";
        if (rank === 3) return " lb-rank-bronze";
        return "";
      }

      function filtered() {
        var q = (searchEl.value || "").trim().toLowerCase();
        if (!q) return current.slice();
        return current.filter(function (item) {
          return String(item.search || "").indexOf(q) !== -1;
        });
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function render() {
        var list = filtered();
        var totalPages = Math.max(1, Math.ceil(list.length / PAGE_SIZE) || 1);
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        var start = (page - 1) * PAGE_SIZE;
        var slice = list.slice(start, start + PAGE_SIZE);

        if (!slice.length) {
          listEl.innerHTML = '<li class="lb-empty-row">No matches</li>';
        } else {
          listEl.innerHTML = slice.map(function (item) {
            var media = item.kind === "game"
              ? (item.image
                  ? '<img src="' + escapeHtml(item.image) + '" alt="" class="lb-thumb" />'
                  : '<div class="lb-thumb lb-thumb-placeholder">?</div>')
              : (item.image
                  ? '<img src="' + escapeHtml(item.image) + '" alt="" class="lb-avatar" />'
                  : '<div class="lb-avatar lb-avatar-placeholder">' + escapeHtml(item.initial || "?") + "</div>");
            return (
              '<li class="lb-row' + medalClass(item.rank) + '">' +
                '<span class="lb-rank' + medalRank(item.rank) + '">' + item.rank + "</span>" +
                '<a href="' + escapeHtml(item.href) + '" class="lb-main">' + media +
                  '<div class="lb-text">' +
                    '<div class="lb-name">' + escapeHtml(item.title) + "</div>" +
                    '<div class="lb-meta">' + escapeHtml(item.meta) + "</div>" +
                  "</div>" +
                "</a>" +
                '<span class="lb-score">' + escapeHtml(item.score) + "</span>" +
              "</li>"
            );
          }).join("");
        }

        if (list.length > PAGE_SIZE) {
          pagerEl.hidden = false;
          pagerEl.innerHTML =
            '<button type="button" class="nav-btn lb-page-btn" data-lb-page="prev"' + (page <= 1 ? " disabled" : "") + ">← Prev</button>" +
            '<span class="lb-page-info">Page ' + page + " of " + totalPages + " · " + list.length + " total</span>" +
            '<button type="button" class="nav-btn lb-page-btn" data-lb-page="next"' + (page >= totalPages ? " disabled" : "") + ">Next →</button>";
        } else if (list.length === 0) {
          pagerEl.hidden = false;
          pagerEl.innerHTML = '<span class="lb-page-info">No matches</span>';
        } else {
          pagerEl.hidden = false;
          pagerEl.innerHTML = '<span class="lb-page-info">' + list.length + " total</span>";
        }
      }

      document.addEventListener("click", function (e) {
        var openBtn = e.target.closest("[data-open-lb-modal]");
        if (openBtn) {
          if (openBtn.disabled) return;
          e.preventDefault();
          var id = openBtn.getAttribute("data-board");
          var dataEl = document.getElementById("lb-data-" + id);
          if (!dataEl) return;
          try {
            current = JSON.parse((dataEl.textContent || "[]").trim());
            if (!Array.isArray(current)) current = [];
          } catch (err) {
            console.error("Leaderboard data parse error", err);
            current = [];
          }
          var meta = boardMeta[id] || {};
          titleEl.textContent = meta.title || "Leaderboard";
          subEl.textContent = meta.subtitle || "";
          searchEl.value = "";
          searchEl.placeholder = openBtn.getAttribute("data-search-ph") || "Search…";
          page = 1;
          openModal();
          render();
          setTimeout(function () { searchEl.focus(); }, 150);
          return;
        }

        if (e.target.closest("[data-close-lb-modal]")) {
          e.preventDefault();
          closeModal();
          return;
        }

        var pageBtn = e.target.closest("[data-lb-page]");
        if (pageBtn && !pageBtn.disabled && modal && !modal.hidden) {
          e.preventDefault();
          if (pageBtn.getAttribute("data-lb-page") === "prev") page -= 1;
          else page += 1;
          render();
        }
      });

      searchEl.addEventListener("input", function () {
        page = 1;
        render();
      });

      window.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && modal && !modal.hidden) closeModal();
      });
    })();
    </script>
    <script src="/js/nav.js"></script>
  </body>
</html>
