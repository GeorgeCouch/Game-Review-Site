# Server
NODE_ENV=production
PORT=3000
SESSION_SECRET=generate-a-long-random-string

# Postgres — either DATABASE_URL *or* discrete vars
DATABASE_URL=postgresql://user:pass@host:5432/gamecouch
# PG_USER=
# PG_HOST=
# PG_DATABASE=
# PG_PASSWORD=
# PG_PORT=5432
# PG_SSL=true

# IGDB / Twitch (same app credentials)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional Google OAuth (if used)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
