<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Review – Game Blog</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-custom fixed-top">
      <div class="container-fluid px-4">
        <a class="navbar-brand" href="/">Video Game <span>Blog</span></a>
        <a href="/" class="nav-btn">← Back</a>
      </div>
    </nav>

    <div class="page-wrapper">
      <div class="form-card">
        <h1>Add a Review</h1>
        <form action="/add-game" method="post">
          <div class="mb-3">
            <label class="form-label">MobyGames Game ID</label>
            <input
              class="form-control"
              type="text"
              name="game_id"
              placeholder="e.g. 12345"
              required
            />
            <div class="form-text text-secondary mt-1" style="font-size: 0.8rem;">
              Find this number in the URL on mobygames.com
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Completed Date</label>
            <input
              class="form-control"
              type="text"
              name="completed"
              placeholder="yyyy-mm-dd"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Personal Rating (0.0 – 5.0)</label>
            <input
              class="form-control"
              type="text"
              name="rating"
              placeholder="4.5"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Review</label>
            <textarea
              class="form-control"
              name="review"
              rows="5"
              placeholder="What did you think of the game?"
              required
            ></textarea>
          </div>

          <button type="submit" class="btn-submit">Add Review</button>
        </form>
      </div>
    </div>
  </body>
</html>