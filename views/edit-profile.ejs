    <script>
      (function () {
        const search = document.getElementById("fav-search");
        const results = document.getElementById("fav-results");
        const status = document.getElementById("fav-status");
        const selected = document.getElementById("fav-selected");
        const clearBtn = document.getElementById("fav-clear");
        if (!search) return;
        let timer = null;

        function escapeHtml(str) {
          return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function pick(game) {
          document.getElementById("fav-title").value = game.name || "";
          document.getElementById("fav-id").value = game.id || "";
          document.getElementById("fav-cover").value = game.cover || "";
          document.getElementById("fav-selected-title").textContent = game.name || "";
          const img = document.getElementById("fav-selected-cover");
          const ph = document.getElementById("fav-selected-placeholder");
          if (game.cover) {
            img.src = game.cover;
            img.style.display = "block";
            if (ph) ph.style.display = "none";
          } else {
            img.removeAttribute("src");
            img.style.display = "none";
            if (ph) ph.style.display = "flex";
          }
          selected.style.display = "flex";
          const searchWrap = document.getElementById("fav-search-wrap");
          if (searchWrap) searchWrap.style.display = "none";
          search.value = "";
          results.innerHTML = "";
          status.textContent = "";
        }

        clearBtn && clearBtn.addEventListener("click", () => {
          document.getElementById("fav-title").value = "";
          document.getElementById("fav-id").value = "";
          document.getElementById("fav-cover").value = "";
          selected.style.display = "none";
          const searchWrap = document.getElementById("fav-search-wrap");
          if (searchWrap) searchWrap.style.display = "";
          search.value = "";
          results.innerHTML = "";
          status.textContent = "";
          search.focus();
        });

        search.addEventListener("input", () => {
          clearTimeout(timer);
          const q = search.value.trim();
          if (q.length < 2) {
            results.innerHTML = "";
            status.textContent = "";
            return;
          }
          status.textContent = "Searching…";
          timer = setTimeout(async () => {
            try {
              const res = await fetch("/api/games/search?q=" + encodeURIComponent(q));
              const data = await res.json();
              if (!res.ok) {
                status.textContent = data.error || "Search failed";
                results.innerHTML = "";
                return;
              }
              const list = data.results || [];
              status.textContent = list.length ? list.length + " result(s)" : "No games found";
              results.innerHTML = list
                .map(
                  (g) =>
                    `<button type="button" class="search-result-item" data-id="${g.id}">
                      ${g.cover ? `<img src="${g.cover}" alt="" />` : `<div class="search-result-placeholder"></div>`}
                      <div>
                        <div class="search-result-name">${escapeHtml(g.name)}</div>
                        <div class="search-result-meta">${g.released ? new Date(g.released).getFullYear() : "—"}</div>
                      </div>
                    </button>`
                )
                .join("");
              results.querySelectorAll(".search-result-item").forEach((btn) => {
                btn.addEventListener("click", () => {
                  const id = parseInt(btn.dataset.id, 10);
                  const game = list.find((x) => x.id === id);
                  if (game) pick(game);
                });
              });
            } catch (e) {
              status.textContent = "Search error";
              results.innerHTML = "";
            }
          }, 300);
        });
      })();
    </script>



      

  <script>
  (function () {
    var input = document.getElementById("banner-input");
    var label = document.getElementById("banner-file-name");
    var btn = document.getElementById("banner-upload-btn");
    function sync() {
      var has = !!(input && input.files && input.files[0]);
      if (label) label.textContent = has ? input.files[0].name : "No file selected";
      if (btn) btn.disabled = !has;
    }
    if (input) {
      input.addEventListener("change", sync);
      sync();
    }
  })();
  </script>

  <script>
  (function () {
    var items = document.querySelectorAll("[data-settings-tab]");
    var panels = document.querySelectorAll("[data-settings-panel]");
    function show(name) {
      panels.forEach(function (p) {
        var on = p.getAttribute("data-settings-panel") === name;
        p.hidden = !on;
        p.classList.toggle("active", on);
      });
      items.forEach(function (b) {
        b.classList.toggle("active", b.getAttribute("data-settings-tab") === name);
      });
      try { history.replaceState(null, "", "#" + name); } catch (e) {}
    }
    items.forEach(function (b) {
      b.addEventListener("click", function () {
        show(b.getAttribute("data-settings-tab"));
      });
    });
    var hash = (location.hash || "").replace("#", "");
    if (hash && document.querySelector('[data-settings-panel="' + hash + '"]')) show(hash);
    else show("profile");
  })();
  </script>
