<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile – GameCouch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
    />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="form-card" style="max-width: 520px;">
        <h1>Edit Profile</h1>

        <% if (typeof error !== "undefined" && error) { %>
          <div class="alert alert-danger" style="background: rgba(255,92,92,0.15); border: 1px solid var(--danger); color: #ff8a8a; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <%= error %>
          </div>
        <% } %>

        <% if (typeof success !== "undefined" && success) { %>
          <div class="alert" style="background: rgba(79,140,255,0.15); border: 1px solid var(--accent); color: #8bb4ff; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <%= success %>
          </div>
        <% } %>

        <form action="/profile/edit" method="POST">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text" style="background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); border-radius: 10px 0 0 10px;">@</span>
              <input
                class="form-control"
                type="text"
                name="username"
                value="<%= user.username || '' %>"
                pattern="[a-z][a-z0-9_]{2,29}"
                title="3–30 characters. Start with a letter. Only lowercase letters, numbers, and underscores."
                required
                style="border-radius: 0 10px 10px 0;"
              />
            </div>
            <small style="color: var(--text-muted); font-size: 0.8rem;">
              3–30 chars. Lowercase letters, numbers, underscores. Must start with a letter.
            </small>
          </div>

          <div class="mb-3">
            <label class="form-label">Display Name</label>
            <input
              class="form-control"
              type="text"
              name="display_name"
              value="<%= user.display_name || '' %>"
              maxlength="100"
              placeholder="How you want to appear"
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Bio</label>
            <textarea
              class="form-control"
              name="bio"
              rows="4"
              maxlength="300"
              placeholder="A short bio about yourself and the games you love..."
            ><%= user.bio || '' %></textarea>
            <small style="color: var(--text-muted); font-size: 0.8rem;">Max 300 characters</small>
          </div>

          <div class="mb-3">
            <label class="form-label">Twitch username (optional)</label>
            <div class="input-group">
              <span class="input-group-text" style="background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); border-radius: 10px 0 0 10px;">twitch.tv/</span>
              <input
                class="form-control"
                type="text"
                name="twitch_username"
                value="<%= user.twitch_username || '' %>"
                placeholder="your_channel"
                maxlength="50"
                style="border-radius: 0 10px 10px 0;"
              />
            </div>
            <small style="color: var(--text-muted); font-size: 0.8rem;">
              If you’re live, your stream will appear on your profile.
            </small>
          </div>

          <div class="mb-3">
            <label class="form-label">YouTube (optional)</label>
            <input
              class="form-control"
              type="text"
              name="youtube_url"
              value="<%= user.youtube_url || '' %>"
              placeholder="@channel or https://youtube.com/@channel"
            />
          </div>

          <div class="mb-3">
            <label class="form-label">X / Twitter (optional)</label>
            <div class="input-group">
              <span class="input-group-text" style="background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted); border-radius: 10px 0 0 10px;">@</span>
              <input
                class="form-control"
                type="text"
                name="x_username"
                value="<%= user.x_username || '' %>"
                placeholder="handle"
                maxlength="50"
                style="border-radius: 0 10px 10px 0;"
              />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Avatar URL (optional)</label>
            <input
              class="form-control"
              type="url"
              name="avatar_url"
              value="<%= user.avatar_url || '' %>"
              placeholder="https://example.com/avatar.jpg"
            />
            <small style="color: var(--text-muted); font-size: 0.8rem;">
              Or paste a direct image link instead of uploading.
            </small>
          </div>

          <button type="submit" class="btn-submit">Save Changes</button>
        </form>

        <div class="avatar-upload-card">
          <h2 style="font-size: 1.1rem; margin: 0 0 0.75rem;">Profile photo</h2>
          <div class="avatar-upload-preview">
            <% if (user.avatar_url) { %>
              <img src="<%= user.avatar_url %>" alt="Current avatar" id="avatar-current" />
            <% } else { %>
              <div class="avatar-upload-placeholder" id="avatar-preview-placeholder">
                <%= (user.display_name || user.username || "?").charAt(0).toUpperCase() %>
              </div>
            <% } %>
          </div>

          <input
            class="form-control"
            type="file"
            name="avatar"
            accept="image/jpeg,image/png,image/gif,image/webp"
            id="avatar-input"
          />
          <small style="color: var(--text-muted); font-size: 0.8rem; display:block; margin: 0.4rem 0 0.75rem;">
            Choose a photo, crop it to a square, then save · max 5 MB
          </small>

          <!-- Cropper panel (hidden until file selected) -->
          <div id="crop-panel" class="crop-panel" style="display: none;">
            <div class="crop-stage">
              <img id="crop-image" alt="Crop preview" />
            </div>
            <div class="crop-actions">
              <button type="button" class="nav-btn" id="crop-cancel">Cancel</button>
              <button type="button" class="nav-btn nav-btn-primary" id="crop-save">Save cropped photo</button>
            </div>
            <div id="crop-status" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem;"></div>
          </div>
        </div>

      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <script>
      (function () {
        const input = document.getElementById("avatar-input");
        const panel = document.getElementById("crop-panel");
        const image = document.getElementById("crop-image");
        const statusEl = document.getElementById("crop-status");
        const btnSave = document.getElementById("crop-save");
        const btnCancel = document.getElementById("crop-cancel");
        let cropper = null;
        let objectUrl = null;

        function destroyCropper() {
          if (cropper) {
            cropper.destroy();
            cropper = null;
          }
          if (objectUrl) {
            URL.revokeObjectURL(objectUrl);
            objectUrl = null;
          }
          image.removeAttribute("src");
          panel.style.display = "none";
          statusEl.textContent = "";
          btnSave.disabled = false;
        }

        input.addEventListener("change", function () {
          const file = input.files && input.files[0];
          if (!file) return;

          if (file.size > 5 * 1024 * 1024) {
            alert("Image must be under 5 MB.");
            input.value = "";
            return;
          }

          destroyCropper();
          objectUrl = URL.createObjectURL(file);
          image.src = objectUrl;
          panel.style.display = "block";

          image.onload = function () {
            cropper = new Cropper(image, {
              aspectRatio: 1,
              viewMode: 1,
              dragMode: "move",
              autoCropArea: 1,
              responsive: true,
              background: false,
              guides: true,
              center: true,
              highlight: false,
              cropBoxMovable: true,
              cropBoxResizable: true,
            });
          };
        });

        btnCancel.addEventListener("click", function () {
          destroyCropper();
          input.value = "";
        });

        btnSave.addEventListener("click", function () {
          if (!cropper) return;
          btnSave.disabled = true;
          statusEl.textContent = "Uploading…";

          // Export a square canvas; server will finalize to 256 WebP
          const canvas = cropper.getCroppedCanvas({
            width: 512,
            height: 512,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: "high",
          });

          if (!canvas) {
            statusEl.textContent = "Could not crop image.";
            btnSave.disabled = false;
            return;
          }

          canvas.toBlob(
            async function (blob) {
              if (!blob) {
                statusEl.textContent = "Could not process image.";
                btnSave.disabled = false;
                return;
              }
              try {
                const form = new FormData();
                form.append("avatar", blob, "avatar.png");
                const res = await fetch("/profile/avatar", {
                  method: "POST",
                  body: form,
                  headers: { Accept: "application/json" },
                });

                // Server currently renders HTML; follow redirect / reload on success
                if (res.redirected) {
                  window.location.href = res.url;
                  return;
                }

                const contentType = res.headers.get("content-type") || "";
                if (contentType.includes("application/json")) {
                  const data = await res.json();
                  if (data.ok) {
                    window.location.reload();
                    return;
                  }
                  statusEl.textContent = data.error || "Upload failed.";
                  btnSave.disabled = false;
                  return;
                }

                // HTML response from server — treat as success and reload edit page
                if (res.ok) {
                  window.location.href = "/profile/edit";
                  return;
                }
                statusEl.textContent = "Upload failed.";
                btnSave.disabled = false;
              } catch (err) {
                statusEl.textContent = "Upload error. Try again.";
                btnSave.disabled = false;
              }
            },
            "image/png",
            0.92
          );
        });
      })();
    </script>
      <script src="/js/nav.js"></script>
  </body>
</html>
