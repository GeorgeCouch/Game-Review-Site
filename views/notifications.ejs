<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notifications – GameCouch</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/styles/styles.css" />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="page-header">
        <div>
          <h1>Notifications</h1>
          <p>
            <% if (notifications && notifications.length) { %>
              <%= notifications.length %> recent
            <% } else { %>
              You’re all caught up
            <% } %>
          </p>
        </div>
        <div class="push-enable-box">
          <button type="button" class="nav-btn nav-btn-primary" id="enable-push">Enable push alerts</button>
          <div id="push-status" class="push-status"></div>
        </div>
      </div>

      <% if (!notifications || notifications.length === 0) { %>
        <div class="empty-state">
          <h2>No notifications yet</h2>
          <p>When someone likes your review, follows you, or comments, it’ll show up here.</p>
        </div>
      <% } else { %>
        <div class="notif-list">
          <% notifications.forEach(function(n) { %>
            <% 
              const actorName = n.actor_display_name || n.actor_username || "Someone";
              const actorLink = n.actor_username ? "/u/" + n.actor_username : "#";
              let text = "";
              let href = actorLink;
              if (n.type === "like") {
                text = "liked your review" + (n.message ? " of " + n.message : "");
                href = n.entity_id ? "/review/" + n.entity_id : actorLink;
              } else if (n.type === "follow") {
                text = "followed you";
                href = actorLink;
              } else if (n.type === "comment") {
                text = "commented on your review" + (n.message ? " of " + n.message : "");
                href = n.entity_id ? "/review/" + n.entity_id : actorLink;
              } else {
                text = n.message || "interacted with you";
              }
              const when = n.created_at
                ? new Date(n.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
                : "";
            %>
            <a href="<%= href %>" class="notif-item<%= n.read ? '' : ' unread' %>">
              <% if (n.actor_avatar) { %>
                <img src="<%= n.actor_avatar %>" alt="" class="notif-avatar" />
              <% } else { %>
                <div class="notif-avatar notif-avatar-placeholder">
                  <%= actorName.charAt(0).toUpperCase() %>
                </div>
              <% } %>
              <div class="notif-body">
                <div class="notif-text">
                  <strong><%= actorName %></strong> <%= text %>
                </div>
                <div class="notif-time"><%= when %></div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
      <script src="/js/push.js"></script>
      <script src="/js/nav.js"></script>
  </body>
</html>
