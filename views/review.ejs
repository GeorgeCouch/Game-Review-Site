<!DOCTYPE html>
<html lang="en">
  <head>
    <title>
      <%= review.title %> – <%= review.author_display_name || review.author_username || "Review" %> – GameCouch
    </title>
    <%- include('partials/head') %>
    <meta property="og:title" content="<%= review.title %> review" />
    <meta property="og:description" content="<%= (review.notes || 'A GameCouch review').toString().slice(0, 160).replace(/"/g, '&quot;') %>" />
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
    <div class="page-wrapper review-page">
      <div class="page-header">
        <div>
          <p class="page-back-link">
            <% if (review.game_id) { %>
              <a href="/game/<%= review.game_id %>">← Back to game</a>
            <% } else { %>
              <a href="/explore">← Explore</a>
            <% } %>
          </p>
          <h1>Review</h1>
          <p>
            <% if (review.author_username) { %>
              by <a href="/u/<%= review.author_username %>" style="color: var(--accent);"><%= review.author_display_name || review.author_username %></a>
            <% } %>
            · <a href="/game/<%= review.game_id %>" style="color: var(--accent);"><%= review.title %></a>
          </p>
        </div>
      </div>

      <div class="game-list review-page-list">
        <% const i = 0; %>
        <%- include("partials/game.ejs", { i: i }) %>
      </div>

      <div class="share-box">
        <label class="form-label" style="margin-bottom: 0.35rem;">Share this review</label>
        <div class="share-row">
          <input class="form-control" type="text" id="share-url" value="<%= shareUrl %>" readonly />
          <button type="button" class="nav-btn nav-btn-primary" id="copy-share">Copy</button>
        </div>
        <div id="copy-status" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem;"></div>
      </div>
    </div>

    <script src="/js/likes.js"></script>
    <script src="/js/report.js"></script>
    <script src="/js/comments.js"></script>
    <script>
      function toggleNotes(id) {
        const notes = document.getElementById("notes-" + id);
        const btn = document.getElementById("expand-" + id);
        if (!notes || !btn) return;
        if (notes.classList.contains("clamped")) {
          notes.classList.remove("clamped");
          btn.textContent = "Show less";
        } else {
          notes.classList.add("clamped");
          btn.textContent = "Read more";
        }
      }
      function startEditComment(id) {
        const body = document.getElementById("comment-body-" + id);
        const form = document.getElementById("edit-form-" + id);
        if (body) body.style.display = "none";
        if (form) form.style.display = "block";
      }
      function cancelEditComment(id) {
        const body = document.getElementById("comment-body-" + id);
        const form = document.getElementById("edit-form-" + id);
        if (form) form.style.display = "none";
        if (body) body.style.display = "";
      }
      document.getElementById("copy-share")?.addEventListener("click", async () => {
        const input = document.getElementById("share-url");
        if (!input) return;
        try {
          await navigator.clipboard.writeText(input.value);
          document.getElementById("copy-status").textContent = "Link copied!";
        } catch (e) {
          input.select();
          document.execCommand("copy");
          document.getElementById("copy-status").textContent = "Link copied!";
        }
      });
    </script>
    <script src="/js/nav.js"></script>
  </body>
</html>
