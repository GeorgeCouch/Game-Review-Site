<!DOCTYPE html>
<html lang="en">
  <head>
    <title>New List – GameCouch</title>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/site-nav', { userlog: typeof userlog !== 'undefined' ? userlog : (typeof user !== 'undefined' ? user : null), showSort: false }) %>
<div class="page-wrapper">
      <div class="form-card">
        <h1>Create a List</h1>

        <% if (typeof error !== "undefined" && error) { %>
          <div style="background: rgba(255,92,92,0.15); border: 1px solid var(--danger); color: #ff8a8a; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <%= error %>
          </div>
        <% } %>

        <form action="/lists" method="POST">
          <div class="mb-3">
            <label class="form-label">Title</label>
            <input
              class="form-control"
              type="text"
              name="title"
              placeholder="e.g. All-time favorites, Best horror 2024"
              maxlength="150"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Description (optional)</label>
            <textarea
              class="form-control"
              name="description"
              rows="3"
              maxlength="500"
              placeholder="What’s this list about?"
            ></textarea>
          </div>


          <button type="submit" class="btn-submit">Create List</button>
        </form>
      </div>
    </div>
      <script src="/js/nav.js"></script>
  </body>
</html>
