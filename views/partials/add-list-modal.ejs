<% if (typeof userlog !== "undefined" && userlog) { %>
<div class="gc-modal" id="add-list-modal" hidden aria-hidden="true">
  <div class="gc-modal-backdrop" data-close-list-modal></div>
  <div class="gc-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="add-list-title">
    <div class="gc-modal-header">
      <div>
        <h2 id="add-list-title">Create a List</h2>
        <p>Name your list and add a short description.</p>
      </div>
      <button type="button" class="gc-modal-close" data-close-list-modal aria-label="Close">&times;</button>
    </div>
    <div class="gc-modal-body">
      <form action="/lists" method="POST" id="create-list-form">
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input
            class="form-control"
            type="text"
            name="title"
            id="list-title-input"
            placeholder="e.g. All-time favorites, Best horror 2024"
            maxlength="150"
            required
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Description (optional)</label>
          <textarea
            class="form-control"
            name="description"
            rows="3"
            maxlength="500"
            placeholder="What's this list about?"
          ></textarea>
        </div>

        <button type="submit" class="btn-submit">Create List</button>
      </form>
    </div>
  </div>
</div>
<script>
(function () {
  const modal = document.getElementById("add-list-modal");
  if (!modal) return;

  function openModal() {
    modal.hidden = false;
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("gc-modal-open");
    modal.classList.remove("is-closing");
    void modal.offsetWidth;
    modal.classList.add("is-open");
    const input = document.getElementById("list-title-input");
    if (input) setTimeout(() => input.focus(), 180);
  }

  function closeModal() {
    if (modal.hidden) return;
    modal.classList.remove("is-open");
    modal.classList.add("is-closing");
    const done = () => {
      modal.hidden = true;
      modal.classList.remove("is-closing");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("gc-modal-open");
      modal.removeEventListener("animationend", done);
    };
    modal.addEventListener("animationend", done);
    setTimeout(done, 220);
  }

  window.openAddListModal = openModal;
  window.closeAddListModal = closeModal;

  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-open-list-modal]")) {
      e.preventDefault();
      openModal();
      return;
    }
    if (e.target.closest("[data-close-list-modal]")) {
      e.preventDefault();
      closeModal();
    }
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.hidden) closeModal();
  });
})();
</script>
<% } %>
