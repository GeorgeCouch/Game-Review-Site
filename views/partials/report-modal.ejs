<% if (typeof userlog !== "undefined" && userlog) { %>
<div class="gc-modal" id="report-modal" hidden aria-hidden="true">
  <div class="gc-modal-backdrop" data-close-report-modal></div>
  <div class="gc-modal-dialog report-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="report-modal-title">
    <div class="gc-modal-header">
      <div>
        <h2 id="report-modal-title">Report review</h2>
        <p>This sends a report to moderators. Abuse of reporting may be reviewed.</p>
      </div>
      <button type="button" class="gc-modal-close" data-close-report-modal aria-label="Close">&times;</button>
    </div>
    <div class="gc-modal-body">
      <p class="report-modal-text">Are you sure you want to report this review?</p>
      <div class="report-modal-actions">
        <button type="button" class="nav-btn" data-close-report-modal>Cancel</button>
        <button type="button" class="nav-btn nav-btn-primary report-confirm-btn" id="report-confirm-btn">Report</button>
      </div>
    </div>
  </div>
</div>
<% } %>
