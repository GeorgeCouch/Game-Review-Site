<%
  // Find matching API data for this game
  let coverUrl = null;
  let releaseDate = userInfo[i].released || "Unknown";
  if (typeof data !== "undefined" && data && data.length) {
    for (let j = 0; j < data.length; j++) {
      if (data[j].game_id == userInfo[i].game_id) {
        if (data[j].sample_cover && data[j].sample_cover.image) {
          coverUrl = data[j].sample_cover.image;
        }
        if (data[j].platforms && data[j].platforms[0] && data[j].platforms[0].first_release_date) {
          releaseDate = data[j].platforms[0].first_release_date;
        }
        break;
      }
    }
  }

  // Stars
  const rating = parseFloat(userInfo[i].rating) || 0;
  const fullStars = Math.floor(rating);
  const hasHalf = (rating % 1) >= 0.5;

  const reviewId = userInfo[i].id;
  const comments = (typeof commentsByReview !== "undefined" && commentsByReview[reviewId]) ? commentsByReview[reviewId] : [];
  const notes = userInfo[i].notes || "";
  const isLong = notes.length > 180;
%>

<div class="game-card" id="review-<%= reviewId %>">
  <% if (coverUrl) { %>
    <img class="game-cover" src="<%= coverUrl %>" alt="<%= userInfo[i].title %> cover" loading="lazy" />
  <% } else { %>
    <div class="game-cover-placeholder">No cover available</div>
  <% } %>

  <div class="game-content">
    <div class="game-meta">
      <span>Released: <%= releaseDate %></span>
      <span>Completed: <%= userInfo[i].completed || "—" %></span>
      <% if (userInfo[i].author_email) { %>
        <span>By: <%= userInfo[i].author_email %></span>
      <% } %>
    </div>

    <div class="stars">
      <% for (let s = 1; s <= 5; s++) { %>
        <% if (s <= fullStars) { %>
          <span class="star">★</span>
        <% } else if (s === fullStars + 1 && hasHalf) { %>
          <span class="star">★</span>
        <% } else { %>
          <span class="star empty">★</span>
        <% } %>
      <% } %>
      <span style="margin-left: 6px; color: var(--text-muted); font-size: 0.85rem;"><%= rating.toFixed(1) %></span>
    </div>

    <h2 class="game-title"><%= userInfo[i].title %></h2>

    <div class="game-notes-wrap">
      <p class="game-notes<%= isLong ? ' clamped' : '' %>" id="notes-<%= reviewId %>"><%= notes %></p>
      <% if (isLong) { %>
        <button type="button" class="expand-btn" onclick="toggleNotes(<%= reviewId %>)" id="expand-<%= reviewId %>">
          Read more
        </button>
      <% } %>
    </div>

    <!-- Comments -->
    <div class="comments-section">
      <div class="comments-header">
        Comments (<%= comments.length %>)
      </div>

      <% if (comments.length > 0) { %>
        <div class="comments-list">
          <% comments.forEach(function(c) { %>
            <div class="comment" id="comment-<%= c.id %>">
              <div class="comment-meta">
                <span class="comment-author"><%= c.author_email %></span>
                <span class="comment-date"><%= new Date(c.created_at).toLocaleDateString() %></span>
              </div>
              <p class="comment-body" id="comment-body-<%= c.id %>"><%= c.content %></p>

              <% if (typeof userlog !== "undefined" && userlog && userlog.id === c.user_id) { %>
                <div class="comment-actions">
                  <button type="button" class="comment-action-btn" onclick="startEditComment(<%= c.id %>)">Edit</button>
                  <form action="/delete-comment" method="post" style="display:inline;" onsubmit="return confirm('Delete this comment?');">
                    <input type="hidden" name="comment_id" value="<%= c.id %>" />
                    <button type="submit" class="comment-action-btn danger">Delete</button>
                  </form>
                </div>
                <form action="/edit-comment" method="post" class="edit-comment-form" id="edit-form-<%= c.id %>" style="display:none;">
                  <input type="hidden" name="comment_id" value="<%= c.id %>" />
                  <textarea name="content" class="form-control comment-edit-input" rows="2" required><%= c.content %></textarea>
                  <div class="edit-comment-btns">
                    <button type="submit" class="nav-btn nav-btn-primary" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;">Save</button>
                    <button type="button" class="nav-btn" style="padding: 0.3rem 0.75rem; font-size: 0.8rem;" onclick="cancelEditComment(<%= c.id %>)">Cancel</button>
                  </div>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (typeof userlog !== "undefined" && userlog) { %>
        <form action="/comment" method="post" class="add-comment-form">
          <input type="hidden" name="review_id" value="<%= reviewId %>" />
          <textarea name="content" class="form-control" rows="2" placeholder="Write a comment..." required></textarea>
          <button type="submit" class="nav-btn nav-btn-primary" style="margin-top: 0.5rem; padding: 0.4rem 1rem; font-size: 0.85rem;">Post Comment</button>
        </form>
      <% } else { %>
        <p class="login-to-comment"><a href="/login" style="color: var(--accent);">Log in</a> to leave a comment</p>
      <% } %>
    </div>
  </div>

  <div class="game-actions">
    <form action="/edit" method="post">
      <button class="action-btn" name="edit" value="<%= userInfo[i].game_id %>" title="Edit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
      </button>
    </form>
    <form action="/delete" method="post" onsubmit="return confirm('Delete this review?');">
      <button class="action-btn delete" name="delete" value="<%= userInfo[i].game_id %>" title="Delete">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          <line x1="10" y1="11" x2="10" y2="17"/>
          <line x1="14" y1="11" x2="14" y2="17"/>
        </svg>
      </button>
    </form>
  </div>
</div>